# Stage 1: Build the binary
FROM golang:alpine AS builder

# Set working directory to the nested server folder
WORKDIR /app/server

# Copy module files and download
COPY server/go.mod server/go.sum ./
RUN go mod download

# Copy the rest of your project into the container
COPY . /app

# Build the binary from INSIDE the server folder using ./
RUN CGO_ENABLED=0 GOOS=linux go build -o /worker ./cmd/worker/main.go

# Stage 2: Create the minimal runtime container
FROM alpine:latest

WORKDIR /app

# ffmpeg needed for transcoding voice notes to a playback format iOS can decode
RUN apk --no-cache add ffmpeg

# Copy only the compiled binary from the builder stage
COPY --from=builder /worker /app/worker
COPY server/.env /app/.env
RUN chmod +x /app/worker

# Run the worker
CMD ["/app/worker"]
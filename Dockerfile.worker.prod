# Stage 1: Build
FROM golang:alpine AS builder

WORKDIR /app/server

# Download deps first — cached unless go.mod/go.sum change
COPY server/go.mod server/go.sum ./
RUN go mod download

# Copy only server source — web/, terraform/, docs/ excluded via .dockerignore
COPY server/ /app/server

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /worker ./cmd/worker/main.go

# Stage 2: Minimal runtime
FROM alpine:latest

# CA certs needed for HTTPS calls to AWS Rekognition, OpenAI Whisper, SES
# ffmpeg needed for transcoding voice notes to a playback format iOS can decode
RUN apk --no-cache add ca-certificates ffmpeg tzdata

WORKDIR /app

COPY --from=builder /worker /app/worker

USER nobody

CMD ["/app/worker"]

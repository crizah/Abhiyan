# Stage 1: Build
FROM golang:1.22-alpine AS builder

WORKDIR /app

# Download deps first — this layer is cached unless go.mod/go.sum change
COPY server/go.mod server/go.sum ./
RUN go mod download

# Copy only the server source — web/, terraform/, docs/ etc. are excluded via .dockerignore
COPY server/ .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -o /worker ./cmd/worker/main.go

# Stage 2: Minimal runtime
FROM alpine:3.20

# CA certs needed for HTTPS calls to AWS Rekognition, OpenAI Whisper, etc.
RUN apk --no-cache add ca-certificates

WORKDIR /app

COPY --from=builder /worker /app/worker

USER nobody

CMD ["/app/worker"]
